[Unit]
Description=Exocomp Coordinator
Documentation=https://github.com/NVShawn/exocomp
After=network-online.target
Wants=network-online.target

# Bound automatic restart churn. Start-limit directives belong to this unit
# section; systemd ignores them when placed in the service section.
StartLimitIntervalSec=120s
StartLimitBurst=4

# ── Ordering and dependency ────────────────────────────────────────────────────
# Require network before starting.  Node connections are accepted after start.

[Service]
Type=exec

# ── Identity ──────────────────────────────────────────────────────────────────
# Run as a dedicated unprivileged account created by the installer.
# @ACCOUNT@ and @INSTALL_DIR@ are substituted by install.sh at install time.
User=@ACCOUNT@
Group=@ACCOUNT@

# ── Executable ────────────────────────────────────────────────────────────────
ExecStart=@INSTALL_DIR@/current/bin/exocomp_coordinator start
# The release stop command requires distributed Erlang RPC, which may not be
# ready during a failed upgrade. The BEAM handles SIGTERM gracefully.
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID

WorkingDirectory=@INSTALL_DIR@

# ── Environment ───────────────────────────────────────────────────────────────
Environment=EXOCOMP_COORDINATOR_CONFIG_FILE=@INSTALL_DIR@/config/coordinator.json
Environment=EXOCOMP_PKI_ONLINE_STATE=@STATE_DIR@/pki
Environment=EXOCOMP_ENROLLMENT_TOKEN_STORE=@STATE_DIR@/enrollment-tokens
Environment=EXOCOMP_TLS_CA_PATH=@STATE_DIR@/pki/root_ca.pem
Environment=EXOCOMP_TLS_CERT_PATH=@STATE_DIR@/pki/coordinator.pem
Environment=EXOCOMP_A2A_TLS_CERT_PATH=@STATE_DIR@/pki/coordinator_chain.pem
Environment=EXOCOMP_TLS_KEY_PATH=@STATE_DIR@/pki/coordinator_key.pem
Environment=EXOCOMP_LOG_DIR=@INSTALL_DIR@/log
Environment=ERL_CRASH_DUMP=@INSTALL_DIR@/log/erl_crash.dump
EnvironmentFile=-@INSTALL_DIR@/config/release-cookie.env
Environment=HOME=@INSTALL_DIR@

# ── Runtime directories ───────────────────────────────────────────────────────
RuntimeDirectory=exocomp-coordinator
RuntimeDirectoryMode=0750

StateDirectory=exocomp-coordinator
StateDirectoryMode=0750

# ── Restart policy ───────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=60s

# ── Logging ───────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exocomp-coordinator

# ── Capability hardening ──────────────────────────────────────────────────────
CapabilityBoundingSet=
AmbientCapabilities=

# ── Privilege escalation prevention ──────────────────────────────────────────
NoNewPrivileges=true
SecureBits=noroot noroot-locked

# ── Filesystem access ─────────────────────────────────────────────────────────
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@INSTALL_DIR@/log @INSTALL_DIR@/config @STATE_DIR@

PrivateTmp=true

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true

RestrictNamespaces=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true

# ── Process and memory restrictions ──────────────────────────────────────────
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true

# ── Device access ─────────────────────────────────────────────────────────────
PrivateDevices=true

# ── System call filter ────────────────────────────────────────────────────────
# The coordinator manages PKI, accepts TLS connections from nodes, and talks
# to an offline root CA.  The same BEAM service syscall profile applies.
SystemCallFilter=@system-service @network-io @file-system @process
SystemCallFilter=~@clock @cpu-emulation @debug @keyring @module @mount @raw-io @reboot @resources @swap @obsolete
SystemCallErrorNumber=EPERM

# ── Address family restriction ────────────────────────────────────────────────
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ── Resource limits ───────────────────────────────────────────────────────────
LimitNOFILE=65536
LimitCORE=0

# ── umask ─────────────────────────────────────────────────────────────────────
UMask=0077

[Install]
WantedBy=multi-user.target
